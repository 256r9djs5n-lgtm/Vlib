		<Item class="Script" referent="RBX00000392">
			<Properties>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local root = script.Parent
local function getTool(hit)
	local inst = hit
	while inst do
		if inst:IsA("Tool") then return inst end
		inst = inst.Parent
	end
end
local flavors = {}
for _, d in ipairs(root:GetDescendants()) do
	if d:IsA("BasePart") and d:FindFirstChild("CoffeeFill")==nil then
		-- flavor bottles are named without Cap suffix
	end
end
local names = {
	["Red Velvet"]=true,["Cookie Dough"]=true,["Vanilla Bean"]=true,["Pumpkin Spice"]=true,
	["Hazelnut"]=true,["Peppermint"]=true,["Cinnamon"]=true,["Mint"]=true,["Caramel"]=true,
	["Strawberry"]=true,["Banana"]=true,["Cherry"]=true,["White Chocolate"]=true,
	["Mocha Sauce"]=true,["Cream"]=true,["Marshmallows"]=true,["Blueberry"]=true,
	["Lemon"]=true,["Orange"]=true,["Raspberry"]=true,
}
local hooked = {}
local function hook(p)
	if hooked[p] or not p:IsA("BasePart") then return end
	if not names[p.Name] then return end
	hooked[p]=true
	p.Touched:Connect(function(hit)
		local tool=getTool(hit)
		if not tool then return end
		local fill=tool:FindFirstChild("CoffeeFill")
		if fill and fill:IsA("BasePart") then
			fill.Color = p.Color
			fill.Transparency = 0.1
		end
		tool.Name = p.Name
		tool.ToolTip = p.Name
	end)
end
for _,d in ipairs(root:GetDescendants()) do hook(d) end
]]></ProtectedString>
				<string name="Name">CoffeeStations</string>
			</Properties>
		</Item>
	</Item>

