		<Item class="LocalScript" referent="RBX00000117">
			<Properties>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local rest = tool.Grip
tool.Activated:Connect(function()
	tool.Grip = rest * CFrame.new(0, 0.85, -0.3) * CFrame.Angles(math.rad(-30), 0, 0)
	task.wait(0.8)
	tool.Grip = rest
end)
]]></ProtectedString>
				<string name="Name">DrinkGrip</string>
			</Properties>
		</Item>
