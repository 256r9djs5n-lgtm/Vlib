<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="LocalScript" referent="RBX1">
		<Properties>
			<bool name="Disabled">false</bool>
			<token name="RunContext">0</token>
			<ProtectedString name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local IGNORE = {
	TouchGui = true,
	ControlGui = true,
	GamepadNavigation = true,
	BubbleChat = true,
	Chat = true,
	PlayerList = true,
	BackpackGui = true,
	HealthGui = true,
	Freecam = true,
	TopbarStandard = true,
	TopbarPlus = true,
	IconContainer = true,
	IconUI = true,
	ExperienceChat = true,
	PurchasePrompt = true,
	DevConsoleMaster = true,
}

local gameBlur = {}
local gameAtmo = {}
local gameDof = {}
local captured = false
local suppressed = false

local function captureGame()
	table.clear(gameBlur)
	table.clear(gameAtmo)
	table.clear(gameDof)
	for _, inst in ipairs(Lighting:GetDescendants()) do
		if inst:IsA("BlurEffect") then
			gameBlur[inst] = { Size = inst.Size, Enabled = inst.Enabled }
		elseif inst:IsA("Atmosphere") then
			gameAtmo[inst] = { Density = inst.Density, Haze = inst.Haze, Glare = inst.Glare }
		elseif inst:IsA("DepthOfFieldEffect") then
			gameDof[inst] = { Enabled = inst.Enabled, FarIntensity = inst.FarIntensity, NearIntensity = inst.NearIntensity }
		end
	end
	captured = true
end

local function suppressGame()
	if not captured then
		captureGame()
	end
	for inst, _ in pairs(gameBlur) do
		if inst.Parent then
			inst.Enabled = false
			inst.Size = 0
		end
	end
	for inst, _ in pairs(gameAtmo) do
		if inst.Parent then
			inst.Density = 0
			inst.Haze = 0
			inst.Glare = 0
		end
	end
	for inst, _ in pairs(gameDof) do
		if inst.Parent then
			inst.Enabled = false
			inst.FarIntensity = 0
			inst.NearIntensity = 0
		end
	end
	suppressed = true
end

local function restoreGame()
	for inst, v in pairs(gameBlur) do
		if inst.Parent then
			inst.Size = v.Size
			inst.Enabled = v.Enabled
		end
	end
	for inst, v in pairs(gameAtmo) do
		if inst.Parent then
			inst.Density = v.Density
			inst.Haze = v.Haze
			inst.Glare = v.Glare
		end
	end
	for inst, v in pairs(gameDof) do
		if inst.Parent then
			inst.Enabled = v.Enabled
			inst.FarIntensity = v.FarIntensity
			inst.NearIntensity = v.NearIntensity
		end
	end
	suppressed = false
end

local function isMenuGui(gui)
	if not gui:IsA("LayerCollector") then
		return false
	end
	if IGNORE[gui.Name] then
		return false
	end
	if string.sub(gui.Name, 1, 3) == "rbx" then
		return false
	end
	return gui.Enabled
end

local function menuOpen(playerGui)
	for _, child in ipairs(playerGui:GetChildren()) do
		if isMenuGui(child) then
			return true
		end
	end
	return false
end

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

task.defer(captureGame)

local function refresh()
	if menuOpen(pg) then
		if not suppressed then
			suppressGame()
		end
	else
		if suppressed then
			restoreGame()
		end
	end
end

pg.ChildAdded:Connect(function()
	task.defer(refresh)
end)
pg.ChildRemoved:Connect(function()
	task.defer(refresh)
end)
pg.DescendantAdded:Connect(function(inst)
	if inst:IsA("ScreenGui") or inst:IsA("BillboardGui") then
		task.defer(refresh)
	end
end)

task.spawn(function()
	while pg.Parent do
		refresh()
		task.wait(0.35)
	end
end)
]]></ProtectedString>
			<string name="Name">MenuBlurAdapter</string>
		</Properties>
	</Item>
</roblox>
