		<Item class="LocalScript" referent="RBX00000112">
			<Properties>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local player = game:GetService("Players").LocalPlayer
local UIS = game:GetService("UserInputService")

local function room()
	return workspace:FindFirstChild("HotelRoom")
end

local function send(cmd)
	local r = room()
	local ev = r and r:FindFirstChild("ACCommand")
	if ev then
		ev:FireServer(cmd)
	end
end

tool.Activated:Connect(function()
	send("power")
end)

local gui
tool.Equipped:Connect(function()
	gui = Instance.new("ScreenGui")
	gui.Name = "ACRemoteUI"
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local f = Instance.new("Frame")
	f.Size = UDim2.fromOffset(160, 220)
	f.Position = UDim2.new(1, -180, 0.5, -110)
	f.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
	f.Parent = gui
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
	local y = 10
	local function btn(text, cmd)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, -20, 0, 28)
		b.Position = UDim2.fromOffset(10, y)
		b.Text = text
		b.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
		b.TextColor3 = Color3.new(1,1,1)
		b.Parent = f
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
		b.MouseButton1Click:Connect(function() send(cmd) end)
		y += 34
	end
	btn("Ac / Kapa", "power")
	btn("Sogutma", "cool")
	btn("Isitma", "heat")
	btn("Fan", "fan")
	btn("Temp +", "up")
	btn("Temp -", "down")
end)

tool.Unequipped:Connect(function()
	if gui then gui:Destroy() gui = nil end
end)
]]></ProtectedString>
				<string name="Name">RemoteClient</string>
			</Properties>
		</Item>
	</Item>
	</Item>
	<Item class="Script" referent="RBX00000113">
		<Properties>
			<bool name="Disabled">false</bool>
			<ProtectedString name="Source"><![CDATA[local root = script.Parent
local lightsOn = true

local function lights()
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("PointLight") then
			d.Enabled = lightsOn
		end
	end
end

local function hookClick(part, fn)
	if not part then return end
	local cd = part:FindFirstChildOfClass("ClickDetector")
	if not cd then
		cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 16
		cd.Parent = part
	end
	cd.MouseClick:Connect(fn)
end

for _, d in ipairs(root:GetDescendants()) do
	if d.Name == "LampShade" or string.sub(d.Name,1,9) == "CeilLight" or d.Name == "LightSwitch" then
		hookClick(d, function()
			lightsOn = not lightsOn
			lights()
		end)
	end
end

local door = root:FindFirstChild("EntranceDoor", true)
local leaf = door and door:FindFirstChild("DoorLeaf")
local doorOpen = false
local doorC0 = leaf and leaf.CFrame
if leaf then
	hookClick(leaf, function()
		doorOpen = not doorOpen
		if doorOpen then
			leaf.CFrame = doorC0 * CFrame.new(-1.6, 0, 0) * CFrame.Angles(0, math.rad(-80), 0)
		else
			leaf.CFrame = doorC0
		end
	end)
end

local fridge = root:FindFirstChild("MiniFridge", true)
local fdoor = fridge and fridge:FindFirstChild("FridgeDoor")
local f0 = fdoor and fdoor.CFrame
local fOpen = false
if fdoor then
	hookClick(fdoor, function()
		fOpen = not fOpen
		if fOpen then
			fdoor.CFrame = f0 * CFrame.new(0.9, 0, 0.4) * CFrame.Angles(0, math.rad(90), 0)
		else
			fdoor.CFrame = f0
		end
	end)
end

local ac = root:FindFirstChild("AirConditioner", true)
local led = ac and ac:FindFirstChild("LED")
local acState = { on = true, temp = 22, mode = "cool" }

local function applyAC()
	if led then
		if not acState.on then
			led.Color = Color3.fromRGB(40, 40, 40)
			led.Material = Enum.Material.SmoothPlastic
		elseif acState.mode == "cool" then
			led.Color = Color3.fromRGB(80, 200, 255)
			led.Material = Enum.Material.Neon
		elseif acState.mode == "heat" then
			led.Color = Color3.fromRGB(255, 140, 60)
			led.Material = Enum.Material.Neon
		else
			led.Color = Color3.fromRGB(180, 255, 140)
			led.Material = Enum.Material.Neon
		end
	end
	root:SetAttribute("ACOn", acState.on)
	root:SetAttribute("ACTemp", acState.temp)
	root:SetAttribute("ACMode", acState.mode)
end
applyAC()

local templates = root:FindFirstChild("Templates")
local remoteTool = templates and templates:FindFirstChild("ACRemote")

local holder = root:FindFirstChild("RemoteHolder", true)
if holder then
	hookClick(holder, function(player)
		if not remoteTool then return end
		local bp = player:FindFirstChild("Backpack")
		if bp and not bp:FindFirstChild("ACRemote") and not (player.Character and player.Character:FindFirstChild("ACRemote")) then
			remoteTool:Clone().Parent = bp
		end
	end)
end

local ev = root:FindFirstChild("ACCommand")
if not ev then
	ev = Instance.new("RemoteEvent")
	ev.Name = "ACCommand"
	ev.Parent = root
end
ev.OnServerEvent:Connect(function(player, cmd)
	if cmd == "power" then
		acState.on = not acState.on
	elseif cmd == "cool" then
		acState.mode = "cool"; acState.on = true
	elseif cmd == "heat" then
		acState.mode = "heat"; acState.on = true
	elseif cmd == "fan" then
		acState.mode = "fan"; acState.on = true
	elseif cmd == "up" then
		acState.temp = math.clamp(acState.temp + 1, 16, 30)
	elseif cmd == "down" then
		acState.temp = math.clamp(acState.temp - 1, 16, 30)
	end
	applyAC()
end)
]]></ProtectedString>
			<string name="Name">RoomController</string>
		</Properties>
	</Item>
	</Item>

</roblox>
