		</Item>		<Item class="Script" referent="RBX00000053">
			<Properties>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[local stand = script.Parent
local clicker = stand:WaitForChild("Clicker")
local det = clicker:FindFirstChildOfClass("ClickDetector")
if not det then
	det = Instance.new("ClickDetector")
	det.MaxActivationDistance = 16
	det.Parent = clicker
end
local templates = stand.Parent:WaitForChild("Templates")
local toolName = "Cup" .. stand.Name
det.MouseClick:Connect(function(player)
	local src = templates:FindFirstChild(toolName)
	if not src then return end
	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return end
	if backpack:FindFirstChild(toolName) or (player.Character and player.Character:FindFirstChild(toolName)) then
		return
	end
	local clone = src:Clone()
	clone.Parent = backpack
end)
]]></ProtectedString>
				<string name="Name">GiveCup</string>
			</Properties>
		</Item>		</Item>
