						<Properties>
							<ProtectedString name="Source"><![CDATA[script.Parent.ClickDetector.MouseClick:connect(function(player)
local cup = script.Parent.Parent:FindFirstChild("Cup")
	cup.CFrame = CFrame.new (cup.CFrame.X,cup.CFrame.Y-0.4,cup.CFrame.Z)
	local tool = script.Tool:clone()
	local handle = script.Parent.Parent.Cup:clone()
	tool.Parent = player.Backpack
	handle.Parent = tool
	handle.Name = "Handle"
	tool.ToolTip = script.Parent.Parent.Name
	tool.Name = "Cup"
	for _,two in pairs(tool:GetChildren()) do
		if two:IsA ("LocalScript") then
			two.Disabled = false	
			wait()		
		end
	end
	for i = 1,8 do
		cup.CFrame = CFrame.new(cup.CFrame.X,cup.CFrame.Y+0.05,cup.CFrame.Z)
		wait()
	end
end)
]]></ProtectedString>
